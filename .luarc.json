{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "Lua 5.1",
  "runtime.builtin": {
    "basic": "disable",
    "debug": "disable",
    "io": "disable",
    "math": "disable",
    "os": "disable",
    "package": "disable",
    "string": "disable",
    "table": "disable",
    "utf8": "disable"
  },
  "workspace.library": [
    ".cache/wow-api/Annotations"
  ],
  "workspace.ignoreDir": [
    ".cache",
    ".luarocks",
    ".venv",
    "tools",
    "spec"
  ],
  "workspace.checkThirdParty": false,
  "diagnostics.globals": [
    "BINDING_HEADER_CRAZYJACKUTILS",
    "BINDING_NAME_CRAZYJACKUTILS_FIND_HOVER",
    "CrazyJackUtilsDB",
    "CrazyJackUtils_FindHover",
    "SLASH_CRAZYJACKUTILSFINDER1",
    "SLASH_CRAZYJACKUTILSFINDER2",
    "SLASH_CRAZYJACKUTILS1",
    "SLASH_CRAZYJACKUTILS2",
    "SLASH_CRAZYJACKUTILS3",
    "InterfaceOptions_AddCategory",
    "ItemDB",
    "LibQuestieDB", "ToggleWorldMap", "WorldMapFrame",
    "NpcDB",
    "QuestDB",
    "InterfaceOptionsFrame_OpenToCategory",
    "Settings",
    "SlashCmdList",
    "TargetFrame",
    "TooltipDataProcessor"
  ]
}
